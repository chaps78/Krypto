# Service systemd du front Django, sur le serveur FRONT (mermoz).
# Ecoute uniquement sur l'IP Tailscale : accessible depuis tes appareils
# Tailscale, invisible depuis Internet.
# Installation : ./deploy/krypto-front.sh (choix 7)
[Unit]
Description=Krypto front (Django)
After=network-online.target tailscaled.service krypto-tunnel.service
Wants=network-online.target

[Service]
User=chaps
WorkingDirectory=/home/chaps/krypto_front/Krypto/front
EnvironmentFile=-/home/chaps/krypto_front/Krypto/front/.env
ExecStart=/home/chaps/krypto_front/Krypto/front/venv/bin/gunicorn krypto_front.wsgi:application --bind 100.90.255.68:8010 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
